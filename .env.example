# Copia este archivo a .env.local (desarrollo) y no lo subas al repo.
# Dev: valores impresos por `npx supabase start` (Supabase local vía Docker).
# Prod: URL/anon key del proyecto Supabase real, configurados como variables
# de entorno del hosting (Vercel u otro), nunca committeadas.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# MR-02: clave de servicio (service_role) para que el administrador cree
# usuarios desde /admin/usuarios/nuevo. Solo servidor: nunca con prefijo
# NEXT_PUBLIC_. Dev: "service_role key" de `npx supabase status`. Prod:
# Project Settings → API del proyecto Supabase, como variable del hosting.
SUPABASE_SERVICE_ROLE_KEY=

# US-03.06: token público de Mapbox para la vista satelital del selector de
# coordenadas del hogar (components/mapa/SelectorCoordenadas.tsx). Opcional:
# sin este token, el selector sigue funcionando con mapa base de
# OpenStreetMap (sin vista satelital). Crear en https://mapbox.com — nivel
# gratuito, verificar condiciones vigentes antes de producción.
NEXT_PUBLIC_MAPBOX_TOKEN=
